{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 3,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Pin Go modules to an exact version; this project never uses ranges.",
      "matchManagers": ["gomod"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Group GitHub Actions updates into a single pull request.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
